{
  "manifest_version": 3,
  "name": "Lomba Video Downloader",
  "version": "1.0.0",
  "description": "Send the current video page to your Lomba Video Downloader server and download it in the quality you choose.",
  "action": {
    "default_title": "Lomba Video Downloader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "storage", "downloads", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
