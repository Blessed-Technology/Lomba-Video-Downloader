# Lomba Video Downloader Environment Configuration

# Allowed hostnames (comma-separated, or * for all supported platforms)
ALLOWED_HOSTS=*

# Maximum allowed duration in seconds (0 = unlimited)
MAX_DURATION_SECONDS=0

# Cache folder for downloads
CACHE_DIR=downloads

# Retention period in hours before cleaning up cached files
KEEP_HOURS=24

# Optional proxy URL (e.g., http://127.0.0.1:7890 or socks5://127.0.0.1:1080)
# PROXY=
